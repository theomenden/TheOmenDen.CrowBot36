<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Central Package Management needs each package to resolve from one explicit source (NU1507).
    TheOmenDen.* comes from the private GitHub Packages feed; everything else from nuget.org.
    The feed key matches the global config so stored credentials apply.
  -->

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github-The-Omen-Den" value="https://nuget.pkg.github.com/theomenden/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github-The-Omen-Den">
      <package pattern="TheOmenDen.*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
